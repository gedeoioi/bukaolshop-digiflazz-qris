generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  role      String   @default("admin") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Store {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(200)
  bukaolshopId  String?  @unique @map("bukaolshop_id") @db.VarChar(100)
  apiKey        String?  @map("api_key") @db.VarChar(500)
  webhookSecret String?  @map("webhook_secret") @db.VarChar(500)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@map("stores")
}

model Product {
  id              String   @id @default(cuid())
  sku             String   @unique @db.VarChar(50)
  name            String   @db.VarChar(200)
  category        String?  @db.VarChar(100)
  brand           String?  @db.VarChar(100)
  description     String?  @db.Text
  supplierPrice   Int      @map("supplier_price")
  sellingPrice    Int      @map("selling_price")
  markup          Int      @default(0)
  digiflazzSku    String?  @unique @map("digiflazz_sku") @db.VarChar(50)
  isActive        Boolean  @default(true) @map("is_active")
  lastSyncedAt    DateTime? @map("last_synced_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  orderItems    OrderItem[]
  transactions  Transaction[]

  @@index([category])
  @@index([isActive])
  @@index([digiflazzSku])
  @@map("products")
}

model Order {
  id             String   @id @default(cuid())
  storeId        String   @map("store_id")
  invoice        String   @unique @db.VarChar(50)
  customerName   String?  @map("customer_name") @db.VarChar(200)
  customerPhone  String?  @map("customer_phone") @db.VarChar(20)
  customerNumber String?  @map("customer_number") @db.VarChar(50)
  productTotal   Int      @map("product_total")
  adminFee       Int      @default(0) @map("admin_fee")
  paymentFee     Int      @default(0) @map("payment_fee")
  totalAmount    Int      @map("total_amount")
  status         String   @default("PENDING_PAYMENT") @db.VarChar(30)
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  store        Store          @relation(fields: [storeId], references: [id])
  items        OrderItem[]
  payment      Payment?
  transaction  Transaction?

  @@index([status])
  @@index([createdAt])
  @@index([storeId])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String @map("order_id")
  productId String @map("product_id")
  quantity  Int    @default(1)
  price     Int
  subtotal  Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payment {
  id              String    @id @default(cuid())
  orderId         String    @unique @map("order_id")
  provider        String    @db.VarChar(50)
  reference       String?   @unique @db.VarChar(100)
  amount          Int
  status          String    @default("PENDING") @db.VarChar(20)
  qrString        String?   @map("qr_string") @db.Text
  qrUrl           String?   @map("qr_url") @db.VarChar(500)
  providerData    Json?     @map("provider_data")
  expiredAt       DateTime? @map("expired_at")
  paidAt          DateTime? @map("paid_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  order        Order          @relation(fields: [orderId], references: [id])
  webhookLogs  WebhookLog[]

  @@index([status])
  @@index([reference])
  @@index([createdAt])
  @@map("payments")
}

model Transaction {
  id                String    @id @default(cuid())
  orderId           String    @unique @map("order_id")
  provider          String    @default("digiflazz") @db.VarChar(50)
  providerReference String?   @unique @map("provider_reference") @db.VarChar(100)
  sku               String    @db.VarChar(50)
  customerNumber    String    @map("customer_number") @db.VarChar(50)
  buyPrice          Int       @map("buy_price")
  sellingPrice      Int       @map("selling_price")
  status            String    @default("PENDING") @db.VarChar(20)
  serialNumber      String?   @map("serial_number") @db.VarChar(200)
  message           String?   @db.Text
  providerData      Json?     @map("provider_data")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [sku], references: [sku])

  @@index([status])
  @@index([sku])
  @@index([createdAt])
  @@map("transactions")
}

model WebhookLog {
  id        String   @id @default(cuid())
  source    String   @db.VarChar(50)
  paymentId String?  @map("payment_id")
  event     String?  @db.VarChar(100)
  payload   Json
  headers   Json?
  signature String?  @db.VarChar(500)
  processed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([source])
  @@index([createdAt])
  @@map("webhook_logs")
}

model NotificationLog {
  id        String   @id @default(cuid())
  type      String   @db.VarChar(50)
  channel   String   @db.VarChar(20)
  recipient String?  @db.VarChar(200)
  message   String   @db.Text
  status    String   @default("SENT") @db.VarChar(20)
  error     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([type])
  @@index([createdAt])
  @@map("notification_logs")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique @db.VarChar(100)
  value String @db.Text
  group String? @db.VarChar(50)

  @@index([group])
  @@map("settings")
}
